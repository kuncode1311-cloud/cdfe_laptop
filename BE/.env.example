# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.

# --- Server ---
PORT=5000
# Nhiều origin cách nhau bằng dấu phẩy; origin ĐẦU TIÊN là trang trả về sau thanh toán PayOS
CLIENT_URL=http://localhost:3000

# --- Cơ sở dữ liệu ---
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/laptop_db?retryWrites=true&w=majority

# --- Xác thực JWT (bắt buộc, dùng chuỗi ngẫu nhiên dài ≥ 32 ký tự) ---
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# --- Thanh toán PayOS / VietQR ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_ENDPOINT=https://api-merchant.payos.vn
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT_NO=
PAYMENT_BANK_ACCOUNT_NAME=

# --- Đăng nhập Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gửi email: production dùng Brevo API (Railway chặn SMTP) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# Chỉ dùng khi chạy local bằng SMTP Gmail
EMAIL_USER=
EMAIL_PASS=

# --- Telegram Bot quản lý đơn hàng ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Trợ lý AI ---
GEMINI_API_KEYS=
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=https://api-trikun.up.railway.app/v1
NINE_ROUTER_MODEL=ag/gemini-3.8-flash-low
